const state = {
  shopId: null,
  shopName: '',
  shopAddress: '',
  shopContacts: [],
  shopPhotos: [],
  editingPhotos: [], // working copy while modal is open
  staffName: '',
  uid: null,
  products: [],
  sales: [],
  customers: [],
