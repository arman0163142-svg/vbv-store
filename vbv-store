  "name": "ভাই বোন ভ্যারাইটিজ স্টোর",
  "short_name": "ভাই বোন স্টোর",
  "description": "দোকানের হিসাবের ডিজিটাল খাতা",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#7A2131",
  "theme_color": "#7A2131",
  "orientation": "portrait",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}

/* ============================================================
   ভাই বোন ভ্যারাইটিজ স্টোর — Design tokens
   Ledger (খাতা) aesthetic: deep red cover, aged paper, brass stitch
   ============================================================ */
:root{
  --red:        #7A2131;
  --red-dark:   #5C1826;
  --cream:      #F4EEDD;
  --cream-deep: #ECE3CB;
  --ink:        #241F1C;
  --ink-soft:   #6B6259;
  --gold:       #B8862E;
  --gold-soft:  #D9B978;
  --line:       #C9B896;
  --green:      #3F6B4C;
  --green-bg:   #E4EDE3;
  --rust:       #B5502D;
  --rust-bg:    #F5E3D8;
  --white:      #FFFDF8;

  --font-display: 'Baloo Da 2', system-ui, sans-serif;
  --font-body:    'Hind Siliguri', system-ui, sans-serif;

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --shadow-card: 0 2px 10px rgba(36,31,28,0.08), 0 1px 2px rgba(36,31,28,0.06);
  --shadow-float: 0 8px 28px rgba(36,31,28,0.18);
}

*{ box-sizing:border-box; margin:0; padding:0; }
html,body{ height:100%; }
body{
  font-family: var(--font-body);
  background: var(--cream);
  color: var(--ink);
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior-y: none;
}
button{ font-family: inherit; cursor:pointer; border:none; background:none; }
input, select{ font-family: inherit; }
h1,h2,h3,h4{ font-family: var(--font-display); }

/* subtle ruled-paper texture used as a background on panels */
.ruled-bg{
  background-image: repeating-linear-gradient(
    to bottom, transparent, transparent 34px, var(--line) 35px
  );
  background-attachment: local;
  opacity: 0.5;
}

/* ============ Screens (onboarding) ============ */
.screen{
  position:fixed; inset:0; display:none;
  overflow-y:auto; -webkit-overflow-scrolling:touch;
}
.screen.active{ display:block; }

.screen-loading{
  display:flex; align-items:center; justify-content:center;
  background: var(--red);
}
.loading-mark{ text-align:center; color: var(--cream); }
.loading-book{
  width:64px; height:80px; margin:0 auto 18px;
  background: var(--cream); border-radius: 4px 10px 10px 4px;
  position:relative; box-shadow: var(--shadow-float);
  animation: pulse 1.4s ease-in-out infinite;
}
.loading-spine{
  position:absolute; left:0; top:0; bottom:0; width:10px;
  background: var(--gold); border-radius: 4px 0 0 4px;
}
@keyframes pulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.08); } }
.loading-text{ font-family: var(--font-display); font-weight:600; letter-spacing:0.02em; }

.screen-welcome{
  background: var(--red);
  background-image: radial-gradient(circle at 20% 10%, rgba(217,185,120,0.15), transparent 55%);
}
.welcome-wrap{
  min-height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding: 32px 28px; text-align:center; gap: 6px;
}
.welcome-emblem{
  width:88px; height:88px; border-radius:50%;
  background: var(--gold); color: var(--red-dark);
  display:flex; align-items:center; justify-content:center;
  font-family: var(--font-display); font-weight:800; font-size:26px;
  letter-spacing:-1px; box-shadow: var(--shadow-float);
  margin-bottom: 18px;
}
.welcome-emblem span{ font-size:16px; display:block; margin-top:-4px; }
.welcome-title{ color: var(--white); font-size: 26px; font-weight:700; margin-bottom:10px; line-height:1.35; }
.welcome-sub{ color: var(--gold-soft); font-size:15px; margin-bottom:36px; line-height:1.6; }
.welcome-actions{ display:flex; flex-direction:column; gap:12px; width:100%; max-width:340px; }

.screen-form{ background: var(--cream); }
.form-wrap{ max-width:420px; margin:0 auto; padding: 20px 22px 40px; }
.back-link{ color: var(--ink-soft); font-size:14px; padding:10px 0; margin-bottom:6px; }
.form-title{ font-size:22px; margin-bottom:8px; }
.form-hint{ color: var(--ink-soft); font-size:14px; margin-bottom:22px; line-height:1.6; }
.form-error{ color: var(--rust); font-size:14px; margin-top:10px; min-height:18px; }

/* ============ Buttons ============ */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  border-radius: var(--radius-md);
  font-weight:600; font-size:15px;
  padding: 13px 20px;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.btn:active{ transform: scale(0.97); }
.btn-lg{ padding:16px 22px; font-size:16px; }
.btn-sm{ padding:9px 16px; font-size:13.5px; border-radius: var(--radius-sm); }
.btn-block{ width:100%; }
.btn-primary{ background: var(--gold); color: var(--red-dark); box-shadow: 0 4px 14px rgba(184,134,46,0.35); }
.btn-ghost{ background: rgba(244,238,221,0.1); color: var(--cream); border: 1.5px solid rgba(244,238,221,0.4); }
.btn-danger-ghost{ color: var(--rust); border: 1.5px solid var(--rust); margin-top:10px; padding:12px; border-radius: var(--radius-md); }

/* ============ Fields ============ */
.field-label{ display:block; font-size:13px; color: var(--ink-soft); font-weight:600; margin: 14px 0 6px; }
.field-input{
  width:100%; padding:13px 14px; border-radius: var(--radius-sm);
  border: 1.5px solid var(--line); background: var(--white);
  font-size:15.5px; color: var(--ink);
}
.field-input:focus{ outline:none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(184,134,46,0.15); }
input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }
input[type="number"]{ -moz-appearance: textfield; }
.field-code{ letter-spacing:6px; text-align:center; font-size:22px; font-weight:700; }
.field-row{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.search-input{ margin-bottom:14px; }
.filter-bar{
  display:flex; align-items:center; justify-content:space-between;
  background: var(--rust-bg); color: var(--rust); border-radius: var(--radius-sm);
  padding:9px 12px; font-size:13px; font-weight:600; margin-bottom:12px;
}
.filter-bar button{ color: var(--rust); font-weight:700; font-size:12.5px; }

/* ============ App shell ============ */
.app-shell{ display:none; flex-direction:column; height:100vh; height:100dvh; }
.app-shell.active{ display:flex; }

.topbar{
  background: var(--red); color: var(--cream);
  padding: 14px 18px; padding-top: max(14px, env(safe-area-inset-top));
  display:flex; align-items:center; justify-content:space-between;
  flex-shrink:0;
}
.topbar-shop{ display:flex; flex-direction:column; }
.topbar-shopname{ font-family:var(--font-display); font-weight:700; font-size:16px; }
.topbar-staff{ font-size:12px; color: var(--gold-soft); margin-top:1px; }
.topbar-status{ display:flex; align-items:center; gap:6px; font-size:11.5px; color: var(--gold-soft); }
.sync-dot{ width:8px; height:8px; border-radius:50%; background: var(--green); box-shadow:0 0 0 3px rgba(63,107,76,0.25); }
.sync-dot.offline{ background: var(--rust); box-shadow:0 0 0 3px rgba(181,80,45,0.25); }

.app-main{ flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; padding: 18px 16px 100px; }

.screen-panel{ display:none; position:relative; }
.screen-panel.active{ display:block; animation: fadein 0.2s ease; }
@keyframes fadein{ from{ opacity:0; transform:translateY(6px);} to{ opacity:1; transform:translateY(0);} }
.panel-title{ font-size:20px; margin-bottom:16px; }
.panel-header-row{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
.panel-header-row .panel-title{ margin-bottom:0; }
.section-subtitle{ font-size:14px; color: var(--ink-soft); margin: 22px 0 10px; font-weight:700; }

/* ============ Shop info card (dashboard header) ============ */
.shop-info-card{
  background: var(--red); color: var(--cream);
  border-radius: var(--radius-lg); padding: 16px 18px;
  margin-bottom: 18px; box-shadow: var(--shadow-card);
}
.shop-info-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
.shop-info-name{ font-size:18px; color: var(--cream); }
.shop-info-address{ font-size:12.5px; color: var(--gold-soft); margin-top:2px; }
.edit-icon-btn{ color: var(--gold-soft); font-size:15px; padding:6px; flex-shrink:0; }
.date-row{ display:flex; gap:8px; margin-top:14px; flex-wrap:wrap; }
.date-chip{
  flex:1; min-width:96px; background: rgba(244,238,221,0.1);
  border-radius: var(--radius-sm); padding:8px 10px;
  display:flex; flex-direction:column; gap:2px;
}
.date-chip-label{ font-size:10.5px; color: var(--gold-soft); font-weight:700; }
.date-chip span:last-child{ font-size:12.5px; font-weight:600; }
.clock-row{ margin-top:10px; font-family: var(--font-display); font-size:15px; font-weight:700; color: var(--gold-soft); text-align:center; }
.contacts-row{ display:flex; flex-direction:column; gap:4px; margin-top:12px; }
.contact-chip{ font-size:12.5px; color: var(--cream); display:flex; gap:6px; }
.contact-chip .cname{ color: var(--gold-soft); font-weight:700; min-width:70px; }
.btn-ghost-red{ color: var(--red); border: 1.5px solid var(--red); background:transparent; margin: 10px 0 6px; }
.contact-edit-row{ display:flex; gap:8px; align-items:center; margin-top:8px; }
.contact-edit-row input{ flex:1; }
.contact-remove-btn{ color: var(--rust); font-size:20px; width:32px; height:32px; flex-shrink:0; }
.owner-photos-row{ display:flex; gap:8px; margin-top:12px; overflow-x:auto; padding-bottom:2px; }
.owner-photo-thumb{ width:52px; height:52px; border-radius:50%; object-fit:cover; border:2px solid var(--gold-soft); flex-shrink:0; }
.photo-thumb-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:8px; }
.photo-thumb-wrap{ position:relative; aspect-ratio:1; border-radius: var(--radius-sm); overflow:hidden; }
.photo-thumb-wrap img{ width:100%; height:100%; object-fit:cover; display:block; }
.photo-thumb-remove{
  position:absolute; top:3px; right:3px; width:22px; height:22px; border-radius:50%;
  background: rgba(36,31,28,0.7); color:#fff; font-size:13px; display:flex; align-items:center; justify-content:center;
}

/* ============ Stat cards ============ */
.stat-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.stat-card{
  position:relative; overflow:hidden;
  background: var(--white); border-radius: var(--radius-md);
  padding: 14px 16px 16px; box-shadow: var(--shadow-card);
  display:flex; flex-direction:column; gap:6px;
  text-align:left; width:100%;
}
.stat-clickable{ cursor:pointer; }
.stat-clickable:active{ transform: scale(0.98); }
.stat-tap-hint{ font-size:10.5px; color: var(--rust); font-weight:700; margin-top:2px; }
.stat-card::before{ content:''; position:absolute; left:0; top:0; bottom:0; width:5px; }
.stat-red::before{ background: var(--red); }
.stat-gold::before{ background: var(--gold); }
.stat-green::before{ background: var(--green); }
.stat-rust::before{ background: var(--rust); }
.stat-wide{ grid-column: 1 / -1; }
.stat-label{ font-size:12.5px; color: var(--ink-soft); font-weight:600; }
.stat-value{ font-family: var(--font-display); font-size:22px; font-weight:700; }

/* ============ List cards (signature: stitched ledger spine) ============ */
.list-stack{ display:flex; flex-direction:column; gap:10px; }
.list-card{
  position:relative;
  background: var(--white); border-radius: var(--radius-md);
  padding: 14px 16px 14px 20px; box-shadow: var(--shadow-card);
  display:flex; align-items:center; justify-content:space-between; gap:10px;
}
.list-card::before{
  content:''; position:absolute; left:7px; top:10px; bottom:10px; width:2px;
  background-image: repeating-linear-gradient(to bottom, var(--gold) 0 4px, transparent 4px 9px);
}
.list-card-main{ display:flex; flex-direction:column; gap:3px; min-width:0; flex:1; }
.list-card-title{ font-weight:700; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.list-card-sub{ font-size:12.5px; color: var(--ink-soft); }
.list-card-value{ font-family: var(--font-display); font-weight:700; font-size:15.5px; text-align:right; white-space:nowrap; }
.list-card-value.due{ color: var(--rust); }
.list-card-value.ok{ color: var(--green); }
.badge{ display:inline-block; font-size:11px; font-weight:700; padding:2px 8px; border-radius:20px; margin-top:2px; width:fit-content; }
.badge-low{ background: var(--rust-bg); color: var(--rust); }
.badge-ok{ background: var(--green-bg); color: var(--green); }
.empty-note{ color: var(--ink-soft); font-size:13.5px; text-align:center; padding: 18px 0; }

/* ============ POS ============ */
.pos-product-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; padding-bottom:90px; }
.pos-product-card{
  background: var(--white); border-radius: var(--radius-md);
  padding: 12px; box-shadow: var(--shadow-card);
  display:flex; flex-direction:column; gap:4px; text-align:left;
  border: 2px solid transparent;
}
.pos-product-card:active{ border-color: var(--gold); }
.pos-product-card.out-of-stock{ opacity:0.45; }
.pos-name{ font-weight:700; font-size:14.5px; }
.pos-price{ font-family: var(--font-display); font-weight:700; color: var(--red); font-size:15px; }
.pos-stock{ font-size:11.5px; color: var(--ink-soft); }

.cart-drawer{
  position:fixed; left:0; right:0;
  bottom: calc(60px + env(safe-area-inset-bottom));
  background: var(--white); border-radius: 20px 20px 0 0;
  box-shadow: 0 -6px 24px rgba(36,31,28,0.18);
  max-height: 74vh; display:flex; flex-direction:column;
  transform: translateY(calc(100% - 56px));
  transition: transform 0.28s cubic-bezier(.32,.72,0,1);
  z-index: 25;
}
.cart-drawer.open{ transform: translateY(0); }
.cart-handle{
  padding: 16px 20px; display:flex; align-items:center; justify-content:space-between;
  font-family: var(--font-display); font-weight:700; color: var(--red-dark);
  flex-shrink:0;
}
.cart-arrow{ transition: transform 0.28s ease; color: var(--ink-soft); }
.cart-drawer.open .cart-arrow{ transform: rotate(180deg); }
.cart-body{ padding: 0 18px 24px; overflow-y:auto; }
.cart-items{ display:flex; flex-direction:column; gap:8px; margin-bottom:6px; }
.cart-item{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 0; border-bottom:1px dashed var(--line); }
.cart-item-name{ font-weight:600; font-size:14px; flex:1; min-width:0; }
.cart-item-qty{ display:flex; align-items:center; gap:8px; }
.qty-btn{ width:28px; height:28px; border-radius:50%; background: var(--cream-deep); font-weight:700; font-size:16px; display:flex; align-items:center; justify-content:center; }
.cart-item-total{ font-family: var(--font-display); font-weight:700; font-size:14px; min-width:60px; text-align:right; }
.cart-customer, .cart-payment{ margin-top:14px; }
.payment-toggle{ display:flex; gap:8px; }
.pay-btn{ flex:1; padding:10px 6px; border-radius: var(--radius-sm); background: var(--cream-deep); font-size:13px; font-weight:600; color: var(--ink-soft); }
.pay-btn.active{ background: var(--red); color: var(--cream); }
.partial-amount-wrap{ margin-top:12px; }
.cart-summary{ margin-top:16px; background: var(--cream); border-radius: var(--radius-sm); padding:12px 14px; }
.cart-summary-row{ display:flex; justify-content:space-between; font-size:14px; padding:4px 0; }
.cart-summary-due{ font-weight:700; color: var(--rust); border-top:1px dashed var(--line); margin-top:4px; padding-top:8px; }
.cart-drawer .btn{ margin-top:16px; }

/* ============ Modals ============ */
.modal-overlay{
  position:fixed; inset:0; background: rgba(36,31,28,0.5);
  display:none; align-items:flex-end; justify-content:center; z-index:100;
}
.modal-overlay.open{ display:flex; }
.modal{
  display:none; background: var(--cream); width:100%; max-width:480px;
  border-radius: 22px 22px 0 0; max-height:88vh; overflow-y:auto;
  animation: slideup 0.25s cubic-bezier(.32,.72,0,1);
}
.modal.open{ display:block; }
@keyframes slideup{ from{ transform: translateY(30px); opacity:0.5; } to{ transform: translateY(0); opacity:1; } }
.modal-head{ display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid var(--line); position:sticky; top:0; background: var(--cream); }
.modal-head h3{ font-size:17px; }
.modal-close{ font-size:18px; color: var(--ink-soft); width:32px; height:32px; }
.modal-body{ padding: 18px 20px 32px; }
.modal-small{ border-radius: var(--radius-lg); margin: auto; max-width:360px; }

.due-highlight{
  background: var(--rust-bg); border-radius: var(--radius-md); padding:16px;
  display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;
}
.due-highlight span:first-child{ font-weight:600; color: var(--ink-soft); font-size:14px; }
.due-highlight span:last-child{ font-family: var(--font-display); font-weight:700; font-size:22px; color: var(--rust); }
.two-btn-row{ display:flex; gap:10px; margin-bottom:16px; }
.two-btn-row .btn{ flex:1; }

.invite-code-box{
  font-family: var(--font-display); font-size:34px; font-weight:800; letter-spacing:8px;
  text-align:center; color: var(--red); background: var(--white);
  border: 2px dashed var(--gold); border-radius: var(--radius-md);
  padding: 18px 10px; margin: 14px 0 20px;
}

/* ============ Bottom nav ============ */
.bottom-nav{
  display:flex; background: var(--white); border-top:1px solid var(--line);
  padding-bottom: env(safe-area-inset-bottom); flex-shrink:0;
  position:relative; z-index:26;
}
.nav-btn{
  flex:1; display:flex; flex-direction:column; align-items:center; gap:3px;
  padding: 9px 4px 8px; color: var(--ink-soft);
}
.nav-btn.active{ color: var(--red); }
.nav-icon{ font-size:20px; }
.nav-label{ font-size:10.5px; font-weight:600; }

/* ============ Toast ============ */
.toast{
  position:fixed; left:50%; bottom:100px; transform: translateX(-50%) translateY(20px);
  background: var(--ink); color: var(--cream); padding:12px 20px; border-radius: 30px;
  font-size:14px; font-weight:600; opacity:0; pointer-events:none; transition: all 0.25s ease;
  z-index:200; white-space:nowrap; box-shadow: var(--shadow-float);
}
.toast.show{ opacity:1; transform: translateX(-50%) translateY(0); }

/* Focus visibility for accessibility */
button:focus-visible, input:focus-visible, select:focus-visible{
  outline: 2.5px solid var(--gold); outline-offset:2px;
}

@media (prefers-reduced-motion: reduce){
  *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
}

@media (min-width:480px){
  .pos-product-grid{ grid-template-columns:1fr 1fr 1fr; }
}

const CACHE_NAME = 'vbv-store-v1';
const ASSETS = [
  './',
  './index.html',
  './styles.css',
  './app.js',
  './firebase-config.js',
  './manifest.json',
  './icon.svg',
];

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(ASSETS)));
  self.skipWaiting();
});

self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys().then(keys => Promise.all(keys.filter(k => k !== CACHE_NAME).map(k => caches.delete(k))))
  );
  self.clients.claim();
});

// Network-first for everything (Firebase needs live network); fall back to cache when offline
self.addEventListener('fetch', (e) => {
  if (e.request.method !== 'GET') return;
  e.respondWith(
    fetch(e.request).then(res => {
      const resClone = res.clone();
      caches.open(CACHE_NAME).then(cache => cache.put(e.request, resClone)).catch(()=>{});
      return res;
    }).catch(() => caches.match(e.request))
  );
});

/* ============================================================
   ভাই বোন ভ্যারাইটিজ স্টোর — App Logic
   ============================================================ */

// ---------- Bengali number helpers ----------
const BN_DIGITS = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
function toBn(num){
  return String(num).replace(/[0-9]/g, d => BN_DIGITS[d]);
}
function money(num){
  num = Math.round(num || 0);
  return '৳' + toBn(num.toLocaleString('en-IN'));
}
function fmtNum(num){ return toBn(Math.round(num||0)); }

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toast._timer);
  toast._timer = setTimeout(()=> t.classList.remove('show'), 2200);
}

// ---------- Bengali calendar conversion (reformed civil calendar, Pohela Boishakh fixed on Apr 14) ----------
function isLeapGregorian(y){ return (y%4===0 && y%100!==0) || y%400===0; }
const BN_MONTHS = ['বৈশাখ','জ্যৈষ্ঠ','আষাঢ়','শ্রাবণ','ভাদ্র','আশ্বিন','কার্তিক','অগ্রহায়ণ','পৌষ','মাঘ','ফাল্গুন','চৈত্র'];
function toBengaliDate(date){
  const y = date.getFullYear();
  const refThisYear = new Date(y,3,14);
  let bYear, daysDiff, choitroLeapYear;
  if (date >= refThisYear){
    bYear = y - 593; daysDiff = Math.floor((date - refThisYear)/86400000); choitroLeapYear = y+1;
  } else {
    const refPrev = new Date(y-1,3,14);
    bYear = y - 594; daysDiff = Math.floor((date - refPrev)/86400000); choitroLeapYear = y;
  }
  const dayOfYear = daysDiff + 1;
  const choitroLen = isLeapGregorian(choitroLeapYear) ? 31 : 30;
  const lens = [31,31,31,31,31,30,30,30,30,30,30,choitroLen];
  let remaining = dayOfYear, m=0;
  while(remaining > lens[m]){ remaining -= lens[m]; m++; }
  return `${toBn(remaining)} ${BN_MONTHS[m]}, ${toBn(bYear)}`;
}

// ---------- Hijri calendar conversion (tabular/arithmetic approximation; may vary ±1 day from moon sighting) ----------
const HIJRI_MONTHS = ['মুহাররম','সফর','রবিউল আউয়াল','রবিউস সানি','জমাদিউল আউয়াল','জমাদিউস সানি','রজব','শাবান','রমজান','শাওয়াল','জিলক্বদ','জিলহজ'];
function gregorianToJD(y,m,d){
  const a = Math.floor((14-m)/12), y2=y+4800-a, m2=m+12*a-3;
  return d + Math.floor((153*m2+2)/5) + 365*y2 + Math.floor(y2/4) - Math.floor(y2/100) + Math.floor(y2/400) - 32045;
}
function toHijriDate(date){
  let jd = gregorianToJD(date.getFullYear(), date.getMonth()+1, date.getDate());
  jd = jd - 1948440 + 10632;
  const n = Math.floor((jd-1)/10631);
  jd = jd - 10631*n + 354;
  const j = (Math.floor((10985-jd)/5316))*(Math.floor((50*jd)/17719)) + (Math.floor(jd/5670))*(Math.floor((43*jd)/15238));
  jd = jd - (Math.floor((30-j)/15))*(Math.floor((17719*j)/50)) - (Math.floor(j/16))*(Math.floor((15238*j)/43)) + 29;
  const m = Math.floor((24*jd)/709);
  const d = jd - Math.floor((709*m)/24);
  const y = 30*n + j - 30;
  return `${toBn(d)} ${HIJRI_MONTHS[m-1]}, ${toBn(y)} হিজরি`;
}

const EN_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
function toEnglishDate(date){
  return `${date.getDate()} ${EN_MONTHS[date.getMonth()]}, ${date.getFullYear()}`;
}

function updateClock(){
  const now = new Date();
  document.getElementById('date-en').textContent = toEnglishDate(now);
  document.getElementById('date-bn').textContent = toBengaliDate(now);
  document.getElementById('date-ar').textContent = toHijriDate(now);
  let h = now.getHours(); const ampm = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12;
  const min = String(now.getMinutes()).padStart(2,'0');
  document.getElementById('clock-now').textContent = `${toBn(h)}:${toBn(min)} ${ampm}`;
}

// ---------- Image compression (client-side, keeps Firestore docs small & free of Storage costs) ----------
function compressImage(file, maxDim=360, quality=0.6){
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        let w = img.width, h = img.height;
        if (w > h && w > maxDim){ h = Math.round(h * maxDim/w); w = maxDim; }
        else if (h >= w && h > maxDim){ w = Math.round(w * maxDim/h); h = maxDim; }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.onerror = reject;
      img.src = e.target.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

