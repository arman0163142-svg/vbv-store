        <span id="cd-due">৳০</span>
      </div>
      <div class="two-btn-row">
        <button class="btn btn-primary btn-block" id="btn-collect-payment">জমা নিন</button>
        <button class="btn btn-ghost-red btn-block" id="btn-add-due">+ নতুন বাকি যোগ করুন</button>
      </div>
      <h4 class="section-subtitle">লেনদেনের ইতিহাস</h4>
      <div class="list-stack" id="cd-transactions"></div>
    </div>
  </div>

  <div class="modal" id="modal-collect">
    <div class="modal-head"><h3>টাকা জমা নিন</h3><button class="modal-close" data-close>✕</button></div>
    <div class="modal-body">
      <label class="field-label">জমার পরিমাণ (৳)</label>
      <input type="number" id="collect-amount" class="field-input" placeholder="০">
      <button class="btn btn-primary btn-lg btn-block" id="btn-confirm-collect">জমা নিশ্চিত করুন</button>
    </div>
  </div>

  <div class="modal" id="modal-add-due">
    <div class="modal-head"><h3>নতুন বাকি যোগ করুন</h3><button class="modal-close" data-close>✕</button></div>
    <div class="modal-body">
      <label class="field-label">কত টাকা বাকি</label>
      <input type="number" id="add-due-amount" class="field-input" placeholder="০">
      <label class="field-label">তারিখ</label>
      <input type="date" id="add-due-date" class="field-input">
      <label class="field-label">বিবরণ (ঐচ্ছিক)</label>
      <input type="text" id="add-due-note" class="field-input" placeholder="যেমনঃ চাল ৫ কেজি, তেল ২ লিটার">
      <button class="btn btn-primary btn-lg btn-block" id="btn-confirm-add-due">যোগ করুন</button>
    </div>
  </div>

  <div class="modal" id="modal-expense">
    <div class="modal-head"><h3>নতুন খরচ</h3><button class="modal-close" data-close>✕</button></div>
    <div class="modal-body">
      <label class="field-label">খরচের খাত</label>
      <select id="ef-category" class="field-input">
        <option value="ভাড়া">ভাড়া</option>
        <option value="বিদ্যুৎ">বিদ্যুৎ বিল</option>
        <option value="পরিবহন">পরিবহন</option>
        <option value="বেতন">স্টাফ বেতন</option>
        <option value="অন্যান্য">অন্যান্য</option>
      </select>
      <label class="field-label">পরিমাণ (৳)</label>
      <input type="number" id="ef-amount" class="field-input" placeholder="০">
      <label class="field-label">নোট (ঐচ্ছিক)</label>
      <input type="text" id="ef-note" class="field-input" placeholder="বিস্তারিত লিখুন">
      <button class="btn btn-primary btn-lg btn-block" id="btn-save-expense">সংরক্ষণ করুন</button>
    </div>
  </div>

  <div class="modal modal-small" id="modal-edit-shop">
    <div class="modal-head"><h3>দোকানের তথ্য সম্পাদনা</h3><button class="modal-close" data-close>✕</button></div>
    <div class="modal-body">
      <label class="field-label">দোকানের নাম</label>
      <input type="text" id="esf-name" class="field-input" placeholder="দোকানের নাম">
      <label class="field-label">ঠিকানা</label>
      <input type="text" id="esf-address" class="field-input" placeholder="দোকানের ঠিকানা">

      <label class="field-label">যোগাযোগের নাম্বার</label>
      <div id="esf-contacts-list"></div>
      <button class="btn btn-ghost-red btn-sm" id="btn-add-contact-row" type="button">+ আরেকটা নাম্বার যোগ করুন</button>

      <label class="field-label">দোকান/মালিকের ছবি</label>
      <div class="photo-thumb-grid" id="esf-photo-grid"></div>
      <button class="btn btn-ghost-red btn-sm" id="btn-add-photo" type="button">+ ছবি যোগ করুন</button>
      <input type="file" id="esf-photo-input" accept="image/*" style="display:none;">
      <p class="form-hint" style="margin-top:6px;font-size:12px;">সর্বোচ্চ ৬টি ছবি, প্রতিটি স্বয়ংক্রিয়ভাবে ছোট করে সংরক্ষণ করা হবে</p>

      <button class="btn btn-primary btn-lg btn-block" id="btn-save-shop-info" style="margin-top:18px;">সংরক্ষণ করুন</button>
    </div>
  </div>

  <div class="modal modal-small" id="modal-invite">
    <div class="modal-head"><h3>দোকান তৈরি হয়েছে!</h3><button class="modal-close" data-close>✕</button></div>
    <div class="modal-body">
      <p class="form-hint">এই কোডটি আপনার স্টাফদের দিন — তারা এই কোড দিয়ে অ্যাপে যোগ দিতে পারবে।</p>
      <div class="invite-code-box" id="invite-code-display">০০০০০০</div>
      <button class="btn btn-primary btn-lg btn-block" id="btn-invite-ok">বুঝেছি, শুরু করি</button>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<!-- Firebase SDK (compat, no build tools needed) -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="firebase-config.js"></script>
<script src="app.js"></script>
</body>
</html>
